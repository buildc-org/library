description "Intel WiFi firmware for iwlwifi adapters"

supports "fedora" "debian" "ubuntu"

family "fedora" { packages "iwlwifi-mvm-firmware" "iwlwifi-mld-firmware" }

family "debian" {
    requires "non-free-firmware"
    packages "firmware-iwlwifi"
}

family "ubuntu" { packages "linux-firmware-intel-wireless" }
