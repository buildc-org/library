description "Podman extras: compose and the TUI, on top of the runtime every bootc image already has"

supports "fedora" "debian" "ubuntu"

packages {
    fedora "podman-compose" "podman-machine" "podman-tui" "slirp4netns"
    debian "podman-compose" "passt" "slirp4netns"
    ubuntu "podman-compose" "passt" "slirp4netns"
}
