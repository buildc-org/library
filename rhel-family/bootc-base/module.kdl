description "Everything a Rocky container image is missing before it is a bootc image: systemd, a kernel, dracut, ostree, bootc, bootupd, an initramfs that carries them, and an ostree-shaped root filesystem"

supports "rhel"

provides "bootc-base"

provides "selinux-policy"

provides "container-runtime"

provides "bootc" "bootupctl" "podman" "crun"
provides "ssh"

requires "build-environment"

packages "systemd" "systemd-udev" "kernel" "dracut" "ostree" "composefs" \
    "bootc" "bootupd" "rpm-ostree" "skopeo" "podman" "crun" \
    "selinux-policy-targeted" "policycoreutils" \
    "NetworkManager" "openssh-server" "sudo" "iproute" \
    "shim-x64" "grub2-efi-x64" "grub2-pc" "efibootmgr" \
    "e2fsprogs" "xfsprogs" "dosfstools" "cryptsetup" "lvm2" \
    "ca-certificates" "curl" "zstd" "less" "man-db"

fragment position="after"
