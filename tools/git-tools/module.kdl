description "Git and its companions: git-delta, git-lfs, and the direnv that rides along"

supports "fedora" "debian" "ubuntu"

packages {
    fedora "direnv" "git" "git-credential-libsecret" "git-delta" "git-lfs"
    debian "direnv" "git" "git-delta" "git-lfs"
    ubuntu "direnv" "git" "git-delta" "git-lfs"
}
