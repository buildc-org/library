schema-version 1

description "CachyOS performance kernel"

targets "fedora"

network "scripts"

provides "kernel" witness="/usr/lib/kernel-build/kernel-package"

key "secureboot" {
    generator "openssl" profile="module-signing" bits=4096
    public "/usr/share/secureboot/sb_cert.der" format="der"
    private "MOK.priv"
}

requires "build-environment" "initramfs-generation" "package-manager/dnf5"

after "os-release"

copr "bieszczaders/kernel-cachyos"
copr "bieszczaders/kernel-cachyos-addons"

collects "dracut.modules" into="/usr/lib/kernel-build/dracut.modules" priority=500

arg "KERNEL"
secret "mok_privkey"
