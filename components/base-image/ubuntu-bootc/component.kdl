schema-version 1

description "Ubuntu bootc base image"

provides {
    "package-manager/apt" witness="/usr/bin/apt-get"
    "libostree" package="libostree-1-1" version="2025.7"
}

component "/deb/build-environment"
component "/deb/bootc-base"

base "docker.io/library/ubuntu:{version}" {
    family "ubuntu"
    bootloader "grub2" "systemd"
}

option "version" type="string" {
    default "26.04"
}
