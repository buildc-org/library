schema-version 1


description "Debian bootc base image"

provides {
    "package-manager/apt" witness="/usr/bin/apt-get"
    "libostree" package="libostree-1-1" version="2026.6"
}

imports "deb/build-environment" "deb/bootc-base" "identity"

base "docker.io/library/debian:$version" {
    family "debian"
    bootloader "grub2" "systemd"
}

option "version" type="string" {
    default "forky"
}
