schema-version 1


description "RHEL bootc base image"

provides {
    "rechunking"
    "initramfs-generation" witness="/usr/bin/dracut"
    "selinux-policy" witness="/usr/sbin/semodule"
    "ssh" witness="/usr/sbin/sshd"
    "bootc" witness="/usr/bin/bootc"
    "bootupctl" witness="/usr/bin/bootupctl"
    "podman" witness="/usr/bin/podman"
    "crun" witness="/usr/bin/crun"
    "package-manager/dnf4" witness="/usr/bin/dnf4"
}

imports "fedora/build-environment" "identity"

base "registry.redhat.io/rhel10/rhel-bootc:$version" {
    family "rhel"
    bootloader "grub2"
    scap-content "ssg-rhel10-ds.xml" {
        pin {
            renovate datasource="github-releases" depName="ComplianceAsCode/content" extractVersion="^v(?<version>.+)$"
            version "0.1.82"
            url "https://github.com/ComplianceAsCode/content/releases/download/v{version}/scap-security-guide-{version}.zip"
            sha256 "3a22f1f747ef7b895268b2da838f680b6a7ea421c5132d6ac4141d858afc60c6" from="manual"
        }
    }
}

option "version" type="string" {
    default "latest"
}
