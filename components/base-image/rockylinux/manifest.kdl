schema-version 1

description "A Rocky Linux bootc image"

provides {
    "package-manager/dnf4" witness="/usr/bin/dnf4"
}

// Rocky Linux publishes no bootc image, so this base starts from the distribution image and imports the RHEL bootc parts.
imports "fedora/build-environment" "rhel/bootc-base" "identity"

base "quay.io/rockylinux/rockylinux:$version" {
    family "rhel"
    bootloader "grub2"
    scap-content "ssg-rl10-ds.xml"
}

option "version" type="string" {
    default "10"
}
