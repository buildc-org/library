schema-version 1

description "KDE Plasma desktop environment"

targets "fedora" "debian" "ubuntu"

provides {
    "graphical-session"
    "wayland"
    "plasma-desktop" witness="/usr/bin/plasmashell"
}

provides "display-manager" exclusive=#true

requires "build-environment"

// plasma-login-manager ships plasmalogin.service without a man page, so verify waives only that finding.
allow-verify "man-page-missing" unit="plasmalogin.service"

packages {
    "plasma-desktop"
    "plasma-workspace"
    "plasma-workspace-wallpapers"
    "kscreen"
    "breeze-icon-theme"
    "xdg-desktop-portal-kde"
    "plasma-nm"
    "plasma-pa"
    "plasma-systemmonitor"
    "bluedevil"
    "plasma-browser-integration"
    "plasma-firewall"
    "dolphin"
    "konsole"
    "ark"
    "kate"
    "ksystemlog"
    "kamera"
    "gvfs"
    "gvfs-fuse"
    "firewalld"
    "accountsservice"
    "tuned"
    "tuned-ppd"
    "thermald"
    "switcheroo-control"
    "udisks2"
    "upower"
    "xdg-user-dirs"
    "pipewire"
    "wireplumber"
    "bluez"
    "pinentry-qt"
}

on "fedora" {
    packages {
        "plasma-login-manager"
        "kcm-plasmalogin"
        "plasma-setup"
        "kwin"
        "kscreenlocker"
        "plasma-breeze"
        "kde-gtk-config"
        "kde-settings-plasmalogin"
        "kde-settings-pulseaudio"
        "polkit-kde"
        "pam-kwallet"
        "kwalletmanager5"
        "plasma-print-manager"
        "plasma-firewall-firewalld"
        "spectacle"
        "kate-plugins"
        "kate-krunner-plugin"
        "gvfs-client"
        "input-remapper"
        "systemd-oomd-defaults"
        "pipewire-pulseaudio"
        "NetworkManager-wifi"
        "NetworkManager-bluetooth"
        "wpa_supplicant"
    }
}
on "ubuntu" {
    packages "plasma-session-wayland" "plasma-session-x11"
}
on "debian" "ubuntu" {
    packages {
        "systemsettings"
        "sddm"
        "sddm-theme-breeze"
        "kwin-wayland"
        "kwin-x11"
        "kde-cli-tools"
        "breeze"
        "kde-config-gtk-style"
        "polkit-kde-agent-1"
        "libpam-kwallet5"
        "kwalletmanager"
        "print-manager"
        "kde-spectacle"
        "gvfs-daemons"
        "input-remapper-daemon"
        "input-remapper-gtk"
        "pipewire-pulse"
        "network-manager"
        "wpasupplicant"
        "fonts-noto-core"
        "fonts-noto-color-emoji"
        "fonts-hack"
    }
}
