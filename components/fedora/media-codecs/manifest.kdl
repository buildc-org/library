schema-version 1

description "Media codecs from a selected repository"

targets "fedora"

option "repo" type="string" {
    description "The repository that provides the codecs"
    default "fedora"
}

imports "repos/$repo"

network "scripts"

requires "build-environment"

on "fedora" {
    packages {
        "libva-utils"
        "pipewire-config-raop"
        "pipewire-gstreamer"
        "pipewire-utils"
    }
}
