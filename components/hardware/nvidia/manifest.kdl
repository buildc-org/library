schema-version 1

description "NVIDIA drivers"

targets "fedora" "debian" "ubuntu"

option "version" type="string" {
    description "The Fedora driver version to install"
    default "latest"
}

option "kernel-modules" type="string" {
    description "Whether to build the kernel modules on Fedora, as build or skip"
    default "build"
}

on "fedora" {
    imports {
        "hardware/nvidia/driver-fedora" {
            version "$version"
            kernel-modules "$kernel-modules"
        }
    }
}

on "debian" { imports "hardware/nvidia/driver-debian" }
on "ubuntu" { imports "hardware/nvidia/driver-ubuntu" }
