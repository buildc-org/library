#!/bin/sh
set -eu

gpu=
for dev in /sys/bus/pci/devices/*; do
    # 0x10de is the NVIDIA PCI vendor identifier.
    [ "$(cat "$dev/vendor")" = 0x10de ] || continue
    # PCI class 0x0300 is a VGA controller and 0x0302 is a 3D controller.
    case "$(cat "$dev/class")" in
        0x0300* | 0x0302*) ;;
        *) continue ;;
    esac
    driver=
    if [ -e "$dev/driver" ]; then
        driver="$(basename "$(readlink "$dev/driver")")"
    fi
    # An unbound device counts because its driver may bind after this udev event.
    case "$driver" in
        '' | nvidia) gpu="$dev" ;;
        *) ;;
    esac
done
if [ -z "$gpu" ]; then
    exit 0
fi

# The kernel module must load before its initstate can be read.
/usr/bin/nvidia-modprobe
waited=0
while [ "$(cat /sys/module/nvidia/initstate)" != live ]; do
    if [ "$waited" -ge 30 ]; then
        echo "nvidia-nodes: /sys/module/nvidia/initstate did not read live within 30 seconds" >&2
        exit 1
    fi
    sleep 1
    waited=$((waited + 1))
done

/usr/bin/nvidia-modprobe -c 255
for info in /proc/driver/nvidia/gpus/*/information; do
    [ -e "$info" ] || continue
    minor="$(sed -n 's/^Device Minor:[[:space:]]*//p' "$info")"
    if [ -z "$minor" ]; then
        echo "nvidia-nodes: no Device Minor line in ${info}" >&2
        exit 1
    fi
    /usr/bin/nvidia-modprobe -c "$minor"
done
/usr/bin/nvidia-modprobe -m
/usr/bin/nvidia-modprobe -u -c 0
