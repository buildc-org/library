schema-version 1

description "Xbox controller driver"

targets "fedora"

permissions {
    scripts {
        network #true
    }
}

requires "kernel-devel"
// The kernel modules are signed with the MOK from secureboot-key and this layer runs after that component to have the key.
after "secureboot-key"

secret "mok_privkey"

asset "xone" {
    pin {
        renovate datasource="git-refs" depName="https://github.com/medusalix/xone"
        version "3484f603484782dd7551c64e5a33fc602b127051"
        url "https://github.com/medusalix/xone.git"
    }
}
