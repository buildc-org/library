description "tect itself, so a booted image answers for its own build with no repository; pinned separately from the buildc-version that built it"

supports "fedora"

provides-file "/usr/bin/tect"
provides-file "/usr/share/buildc/assets"

asset "tect" {
    pin {
        renovate datasource="github-releases" depName="buildc-org/buildc"
        version "0.6.20"
        url "https://github.com/buildc-org/buildc/releases/download/v{version}/tect-v{version}-x86_64-linux-musl.tar.gz"
        sha256 "a9f0e1b655c1172637ed116ac20870b95abd739835476a7bfdf4989c0786e118" from="sidecar"
    }
}
