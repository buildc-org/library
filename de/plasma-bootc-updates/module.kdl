description "bootc updates panel for KDE System Settings, with its notifier"

supports "fedora"

requires "plasma-desktop"

asset "buildc-bootc-updates" {
    renovate datasource="github-releases" depName="buildc-org/plasma-bootc-updates" extractVersion="^v(?<version>.*)$"
    version "0.1.1"
    url "https://github.com/buildc-org/plasma-bootc-updates/releases/download/v{version}/buildc-bootc-updates-{version}-1.fc44.x86_64.rpm"
    sha256 "2272f4682aff39bd0bff7b2b13db71854da971eda99b6e84653ba1da32d94b7a"
}
