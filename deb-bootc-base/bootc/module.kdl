description "Everything a deb-family container image is missing before it is a bootc image: a kernel, dracut, ostree, bootc itself, an initramfs that carries it, and an ostree-shaped root filesystem"

supports "debian" "ubuntu"

provides "bootc-base"

provides-file "/usr/bin/bootc"
provides-file "/usr/bin/bootupctl"
provides-file "/usr/lib/sysimage/dpkg"
provides-file "/usr/sbin/sshd"

requires "build-environment"

requires "container-runtime"

asset "bootc" {
    pin {
        renovate datasource="github-releases" depName="bootc-dev/bootc"
        version "1.16.10"
        url "https://github.com/bootc-dev/bootc/releases/download/v{version}/bootc-{version}.tar.zstd"
        sha256 "1819e7bafabc26d0cbf544a94515c17eccfea449ea780527dc8b3d766f49de46"
    }
}

asset "bootc-vendor" {
    pin {
        renovate datasource="github-releases" depName="bootc-dev/bootc"
        version "1.16.10"
        url "https://github.com/bootc-dev/bootc/releases/download/v{version}/bootc-{version}-vendor.tar.zstd"
        sha256 "79185625d2a44f5e209155cdd1db7a81d3058decaaf6b32453688263f821d400"
    }
}

asset "bootupd" {
    pin {
        renovate datasource="github-releases" depName="coreos/bootupd"
        version "0.3.1"
        url "https://github.com/coreos/bootupd/releases/download/v{version}/bootupd-{version}.crate"
        sha256 "335ac06a450d59f4154a81ed96186e6296c799a584cfa3c3916c7a0023498c38"
    }
}

asset "bootupd-vendor" {
    pin {
        renovate datasource="github-releases" depName="coreos/bootupd"
        version "0.3.1"
        url "https://github.com/coreos/bootupd/releases/download/v{version}/bootupd-{version}-vendor.tar.zstd"
        sha256 "b9348f75a7c94f727e3a7bf2487113348431ea69c6d757ec3edcd626c0cb8576"
    }
}

packages {
    debian "linux-image-amd64" "firmware-linux-free" \
           "dracut" "ostree" "composefs" \
           "systemd-boot" "systemd-boot-efi" \
           "shim-signed" "grub-efi-amd64-signed" "grub-common" \
           "systemd-resolved" "libnss-resolve" "libnss-myhostname" \
           "skopeo" "ca-certificates" "zstd" "curl" \
           "btrfs-progs" "xfsprogs" "e2fsprogs" "dosfstools" "fdisk" \
           "efibootmgr" "cryptsetup-bin" "dmsetup" \
           "openssh-server" "sudo" "less" "man-db"
    ubuntu "linux-image-generic" "linux-firmware-minimal" \
           "dracut" "ostree" "composefs" \
           "systemd-boot" "systemd-boot-efi" \
           "shim-signed" "grub-efi-amd64-signed" "grub-common" \
           "systemd-resolved" "libnss-resolve" "libnss-myhostname" \
           "skopeo" "ca-certificates" "zstd" "curl" \
           "btrfs-progs" "xfsprogs" "e2fsprogs" "dosfstools" "fdisk" \
           "efibootmgr" "cryptsetup-bin" "dmsetup" \
           "openssh-server" "sudo" "less" "man-db"
}

fragment position="after"
