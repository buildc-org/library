description "The two ways into a machine, neither of which a base should decide for one: the ssh daemon enabled, and a console account a hypervisor can create with systemd credentials"

supports "fedora" "debian" "ubuntu"

requires "ssh"

key "ssh" {
    generator "ssh-keygen"
    public "/usr/lib/buildc/authorized_keys"
    private "id_ed25519"
}
