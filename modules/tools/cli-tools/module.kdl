description "Traditional CLI utilities: tmux, htop, rsync, vim and friends"

supports "fedora" "debian" "ubuntu"

packages "bash-completion" "bc" "btop" "htop" "iw" "mtr" "pv" "rsync" "tmux" \
    "tree" "whois" "wl-clipboard" "zip"

family "fedora" { packages "7zip-standalone" "bsdunzip" "vim-enhanced" }
family "debian" "ubuntu" { packages "7zip" "libarchive-tools" "vim" }
