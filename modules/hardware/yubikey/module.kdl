schema-version 1

description "Hardware token and smartcard auth: YubiKey, FIDO2, PAM and PC/SC"

supports "fedora" "debian" "ubuntu"

requires "build-environment"

packages "opensc" "pamu2fcfg" "yubikey-manager"

family "fedora" {
    packages "pam-u2f" "pam_yubico" "pcsc-lite" "pcsc-lite-ccid"
}
family "debian" "ubuntu" {
    packages "libpam-u2f" "libpam-yubico" "pcscd" "libccid"
}
